<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
		 colors="true"
		 stopOnFailure="false">
	<testsuites>
		<testsuite name="Application Test Suite">
			<directory>./tests</directory>
		</testsuite>

		<testsuite name="unit">
			<directory>./tests</directory>
			<exclude>./tests/Services</exclude>
			<exclude>./tests/Repositories</exclude>
		</testsuite>

		<testsuite name="integration">
			<directory>./tests/Services</directory>
			<directory>./tests/Repositories</directory>
		</testsuite>
	</testsuites>

	<php>
		<env name="DB_HOST" value="mysql_test" force="true"/>
		<env name="DB_NAME" value="videocms" force="true"/>
		<env name="DB_USER" value="root" force="true"/>
		<env name="DB_PASS" value="root" force="true"/>

		<env name="REDIS_HOST" value="redis_test" force="true"/>
		<env name="REDIS_PORT" value="6379" force="true"/>

		<env name="ELASTIC_HOST" value="elasticsearch_test:9200" force="true"/>
	</php>

</phpunit>
