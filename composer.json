{
    "name": "dejvidbushi/video-cms-app",
    "description": "A minimal Video CMS App",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dejvid Bushi",
            "email": "dejvid.bushi@gmail.com"
        }
    ],
    "require": {
		"ext-json": "*",
		"ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
		"ext-redis": "*",
        "elasticsearch/elasticsearch": "^8.17",
        "php-amqplib/php-amqplib": "^3.7"
	},
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.12",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "tests:integration": "docker compose -f docker-compose.test.yml -p video-cms-app-tests up --build --abort-on-container-exit --remove-orphans; docker compose -f docker-compose.test.yml -p video-cms-app-tests down --volumes --remove-orphans",
        "tests:unit": "./vendor/bin/phpunit --testsuite unit",
        "cs": "./vendor/bin/phpcs",
        "cbf": "./vendor/bin/phpcbf",
        "stan": "./vendor/bin/phpstan"
    }
}
